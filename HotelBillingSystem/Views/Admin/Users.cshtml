@model IEnumerable<HotelBillingSystem.Models.ApplicationUser>
@{
    ViewData["Title"] = "User & Staff Management";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="fas fa-users-cog me-2 text-primary"></i> User & Staff Management</h2>
        <p class="text-muted mb-0">Manage system users, administrators, kitchen chefs, and cashier accounts</p>
    </div>
    <a asp-action="CreateUser" class="btn btn-success fw-bold rounded-pill px-4 shadow-sm">
        <i class="fas fa-user-plus me-2"></i> Create New Staff Account
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Full Name</th>
                        <th>Email / Username</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Created At</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="fw-bold">@user.FullName</td>
                            <td><code>@user.Email</code></td>
                            <td>
                                @if (user.StaffRole == "Admin")
                                {
                                    <span class="badge bg-danger">Admin</span>
                                }
                                else if (user.StaffRole == "KitchenStaff")
                                {
                                    <span class="badge bg-warning text-dark">Kitchen Staff</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Cashier Staff</span>
                                }
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Deactivated</span>
                                }
                            </td>
                            <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">
                                <button onclick="toggleUserStatus('@user.Id')" class="btn btn-sm btn-outline-secondary fw-bold">
                                    <i class="fas fa-power-off me-1"></i> Toggle Status
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function toggleUserStatus(userId) {
        if (!confirm('Are you sure you want to activate/deactivate this user account?')) return;

        let res = await fetch(`/Admin/ToggleUserStatus?userId=${userId}`, { method: 'POST' });
        let data = await res.json();
        if (data.success) {
            window.location.reload();
        } else {
            alert('Failed to update status.');
        }
    }
</script>
}
