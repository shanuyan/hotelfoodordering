@model IEnumerable<HotelBillingSystem.Models.RestaurantTable>
@{
    ViewData["Title"] = "Table & QR Code Management";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="fas fa-qrcode me-2 text-primary"></i> Restaurant Tables & QR Codes</h2>
        <p class="text-muted mb-0">Generate and manage table QR codes for customer web ordering</p>
    </div>
    <button class="btn btn-primary fw-bold rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#createTableModal">
        <i class="fas fa-plus me-2"></i> Add New Table
    </button>
</div>

<div class="row g-3">
    @foreach (var table in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="fw-bold text-dark mb-0"><i class="fas fa-chair text-primary me-2"></i> @table.TableNumber</h4>
                        <span class="badge bg-info">Capacity: @table.Capacity Seats</span>
                    </div>

                    <p class="text-muted mb-2"><i class="fas fa-location-dot me-1"></i> Section: <strong>@table.Location</strong></p>
                    <p class="text-muted mb-3"><i class="fas fa-key me-1"></i> QR Token: <code>@table.QrToken</code></p>

                    <div class="d-flex justify-content-between gap-2 mt-4">
                        <a asp-action="ViewQr" asp-route-tableId="@table.Id" class="btn btn-outline-primary fw-bold rounded-pill w-100">
                            <i class="fas fa-qrcode me-1"></i> View / Print QR
                        </a>
                        <form asp-action="RegenerateQr" method="post" class="w-100">
                            <input type="hidden" name="tableId" value="@table.Id" />
                            <button type="submit" class="btn btn-outline-warning text-dark fw-bold rounded-pill w-100" onclick="return confirm('Regenerate QR Code? Existing printed QR codes will be invalidated.')">
                                <i class="fas fa-sync me-1"></i> Regenerate
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal Create Table -->
<div class="modal fade" id="createTableModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0">
            <div class="modal-header bg-primary text-white rounded-top-4">
                <h5 class="modal-title fw-bold">Add Restaurant Table</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateTable" method="post">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Table Number / Label</label>
                        <input type="text" name="tableNumber" class="form-control" placeholder="e.g. Table 11" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Seating Capacity</label>
                        <input type="number" name="capacity" class="form-control" value="4" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Location / Section</label>
                        <input type="text" name="location" class="form-control" value="Main Hall" required />
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold rounded-pill px-4">Create Table</button>
                </div>
            </form>
        </div>
    </div>
</div>
