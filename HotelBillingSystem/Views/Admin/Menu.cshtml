@model IEnumerable<HotelBillingSystem.Models.FoodItem>
@{
    ViewData["Title"] = "Food Menu & Real-time Availability";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="fas fa-hamburger me-2 text-warning"></i> Food Menu & Availability Control</h2>
        <p class="text-muted mb-0">Toggle item availability in real time across customer mobile screens</p>
    </div>
    <a asp-action="CreateFood" class="btn btn-success fw-bold rounded-pill px-4 shadow-sm">
        <i class="fas fa-plus me-2"></i> Add Food Item
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Food Item</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Prep Time</th>
                        <th>Availability</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark fs-6">@item.Name</div>
                                <small class="text-muted">@item.Description</small>
                            </td>
                            <td><span class="badge bg-secondary">@item.Category?.Name</span></td>
                            <td class="fw-bold text-primary">Rs. @item.Price.ToString("N2")</td>
                            <td>~@item.PrepTimeMinutes min</td>
                            <td>
                                @if (item.IsAvailable)
                                {
                                    <span class="badge bg-success fs-6" id="badge-@item.Id">🟢 Available</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger fs-6" id="badge-@item.Id">🔴 Unavailable</span>
                                }
                            </td>
                            <td class="text-end">
                                <button onclick="toggleAvailability(@item.Id)" class="btn btn-sm btn-outline-primary fw-bold">
                                    <i class="fas fa-toggle-on me-1"></i> Toggle Availability
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function toggleAvailability(foodId) {
        let res = await fetch(`/Admin/ToggleFoodAvailability?foodId=${foodId}`, { method: 'POST' });
        let data = await res.json();
        if (data.success) {
            let badge = document.getElementById(`badge-${foodId}`);
            if (data.isAvailable) {
                badge.className = 'badge bg-success fs-6';
                badge.innerText = '🟢 Available';
            } else {
                badge.className = 'badge bg-danger fs-6';
                badge.innerText = '🔴 Unavailable';
            }
        } else {
            alert('Failed to update availability.');
        }
    }
</script>
}
