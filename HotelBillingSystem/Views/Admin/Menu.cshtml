@model IEnumerable<HotelBillingSystem.Models.FoodItem>
@{
    ViewData["Title"] = "Food Menu Management";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded-4 shadow-sm border">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="fas fa-hamburger me-2 text-warning"></i> Menu & Availability Control</h2>
        <p class="text-muted mb-0">Toggle Daily Menu vs Regular Menu and Real-time Availability</p>
    </div>
    <a asp-action="CreateFood" class="btn btn-success fw-bold rounded-pill px-4 shadow">
        <i class="fas fa-plus me-2"></i> Add Food Item
    </a>
</div>

<div class="card card-custom bg-white border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Food Item</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Menu Type</th>
                        <th>Availability</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark fs-6">@item.Name</div>
                                <small class="text-muted">@item.Description</small>
                            </td>
                            <td><span class="badge bg-secondary">@item.Category?.Name</span></td>
                            <td class="fw-bold text-primary">Rs. @item.Price.ToString("N2")</td>
                            <td>
                                @if (item.IsDailyMenu)
                                {
                                    <span class="badge bg-warning text-dark fs-6" id="daily-badge-@item.Id">🔥 Daily Special</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-white fs-6" id="daily-badge-@item.Id">📖 Regular Menu</span>
                                }
                            </td>
                            <td>
                                @if (item.IsAvailable)
                                {
                                    <span class="badge bg-success fs-6" id="badge-@item.Id">🟢 Available</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger fs-6" id="badge-@item.Id">🔴 Sold Out</span>
                                }
                            </td>
                            <td class="text-end">
                                <button onclick="toggleDailyMenu(@item.Id)" class="btn btn-sm btn-outline-warning text-dark fw-bold me-1">
                                    <i class="fas fa-fire me-1"></i> Toggle Daily/Regular
                                </button>
                                <button onclick="toggleAvailability(@item.Id)" class="btn btn-sm btn-outline-primary fw-bold">
                                    <i class="fas fa-toggle-on me-1"></i> Toggle Availability
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function toggleDailyMenu(foodId) {
        let res = await fetch(`/Admin/ToggleDailyMenu?foodId=${foodId}`, { method: 'POST' });
        let data = await res.json();
        if (data.success) {
            let badge = document.getElementById(`daily-badge-${foodId}`);
            if (data.isDailyMenu) {
                badge.className = 'badge bg-warning text-dark fs-6';
                badge.innerText = '🔥 Daily Special';
            } else {
                badge.className = 'badge bg-info text-white fs-6';
                badge.innerText = '📖 Regular Menu';
            }
        } else {
            Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to update menu type.' });
        }
    }

    async function toggleAvailability(foodId) {
        let res = await fetch(`/Admin/ToggleFoodAvailability?foodId=${foodId}`, { method: 'POST' });
        let data = await res.json();
        if (data.success) {
            let badge = document.getElementById(`badge-${foodId}`);
            if (data.isAvailable) {
                badge.className = 'badge bg-success fs-6';
                badge.innerText = '🟢 Available';
            } else {
                badge.className = 'badge bg-danger fs-6';
                badge.innerText = '🔴 Sold Out';
            }
        } else {
            Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to update availability.' });
        }
    }
</script>
}
