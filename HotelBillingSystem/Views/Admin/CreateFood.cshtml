@model HotelBillingSystem.ViewModels.FoodItemCreateEditViewModel
@{
    ViewData["Title"] = "Add New Food Item";
    Layout = "_Layout";
}

<div class="row justify-content-center my-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-lg rounded-4">
            <div class="card-header bg-success text-white p-4 text-center rounded-top-4">
                <h4 class="fw-bold mb-0"><i class="fas fa-plus-circle me-2"></i> Add New Menu Item</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateFood" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold">Food Name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Cheese Kottu Special" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label fw-bold">Food Category</label>
                        <select asp-for="CategoryId" class="form-select fw-bold">
                            @foreach (var cat in (List<HotelBillingSystem.Models.FoodCategory>)ViewBag.Categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Price" class="form-label fw-bold">Price (Rs.)</label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control fw-bold text-primary" placeholder="1250.00" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="PrepTimeMinutes" class="form-label fw-bold">Estimated Prep Time (Minutes)</label>
                        <input asp-for="PrepTimeMinutes" type="number" class="form-control" value="15" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="2" placeholder="Ingredients and details..."></textarea>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="IsAvailable" class="form-check-input" checked />
                        <label asp-for="IsAvailable" class="form-check-label fw-bold">Currently Available for Ordering</label>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Menu" class="btn btn-outline-secondary fw-bold rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn btn-success fw-bold rounded-pill px-4 shadow-sm">Save Food Item</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
