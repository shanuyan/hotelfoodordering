@model HotelBillingSystem.Models.RestaurantTable
@{
    ViewData["Title"] = $"QR Code - {Model.TableNumber}";
    Layout = "_Layout";
}

<div class="container my-4 d-flex justify-content-center">
    <div class="card shadow-lg border-0 p-5 rounded-4 text-center bg-white" style="max-width: 500px; width: 100%;">
        <h2 class="fw-bold text-primary mb-1"><i class="fas fa-utensils me-2"></i> Smart Hotel Billing</h2>
        <p class="text-muted mb-3">Scan to View Menu & Place Order</p>

        <div class="bg-light p-4 rounded-4 my-3 d-inline-block border">
            <img src="@ViewBag.QrBase64" alt="Table QR Code" class="img-fluid rounded shadow-sm" style="max-width: 280px;" />
        </div>

        <h3 class="fw-bold text-dark mt-2 mb-1">@Model.TableNumber</h3>
        <p class="text-muted mb-3">Section: <strong>@Model.Location</strong> | Capacity: <strong>@Model.Capacity Seats</strong></p>

        <div class="alert alert-secondary text-break small py-2">
            Target URL: <br /><code>@ViewBag.QrUrl</code>
        </div>

        <div class="d-print-none mt-3">
            <button onclick="window.print()" class="btn btn-primary btn-lg fw-bold rounded-pill px-4 me-2">
                <i class="fas fa-print me-2"></i> Print Table Stand
            </button>
            <a asp-action="Tables" class="btn btn-outline-secondary btn-lg fw-bold rounded-pill px-4">Back</a>
        </div>
    </div>
</div>
