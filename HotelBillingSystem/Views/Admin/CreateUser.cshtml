@model HotelBillingSystem.ViewModels.UserCreateEditViewModel
@{
    ViewData["Title"] = "Create Staff Account";
    Layout = "_Layout";
}

<div class="row justify-content-center my-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-lg rounded-4">
            <div class="card-header bg-primary text-white p-4 text-center rounded-top-4">
                <h4 class="fw-bold mb-0"><i class="fas fa-user-plus me-2"></i> Create Staff Account</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateUser" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-bold">Full Name</label>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. Chef Sanath Perera" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold">Email Address</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="staff@hotel.com" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="StaffRole" class="form-label fw-bold">Assigned Role</label>
                        <select asp-for="StaffRole" class="form-select fw-bold">
                            <option value="KitchenStaff">Kitchen Staff (Chef)</option>
                            <option value="CashierStaff">Cashier / Billing Staff</option>
                            <option value="Admin">System Administrator</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold">Password</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Default: Staff@123" required />
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="IsActive" class="form-check-input" checked />
                        <label asp-for="IsActive" class="form-check-label fw-bold">Is Account Active</label>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Users" class="btn btn-outline-secondary fw-bold rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary fw-bold rounded-pill px-4 shadow-sm">Save User</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
