@{
    ViewData["Title"] = "Hotel Staff Portal";
    Layout = "_Layout";
}

<!-- Hotel Overview Banner -->
<div class="card border-0 rounded-4 overflow-hidden mb-4 text-white shadow-lg" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
    <div class="card-body p-5">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-warning text-dark fw-bold text-uppercase px-3 py-2 mb-3 rounded-pill">
                    <i class="fas fa-hotel me-1"></i> Smart Hotel & Restaurant
                </span>
                <h1 class="display-4 fw-bold mb-2">Hotel Staff Management Portal</h1>
                <p class="fs-5 text-light opacity-90 mb-4">Dedicated operational portal for Kitchen Staff (Chefs) and Cashier Billing Staff.</p>

                <div class="d-flex flex-wrap gap-4 text-light small">
                    <div><i class="fas fa-map-marker-alt text-warning me-2 fs-5"></i> No 123, Beach Road, Colombo</div>
                    <div><i class="fas fa-phone-alt text-success me-2 fs-5"></i> +94 11 234 5678</div>
                    <div><i class="fas fa-clock text-info me-2 fs-5"></i> Open Daily: 07:00 AM - 11:00 PM</div>
                </div>
            </div>
            <div class="col-lg-4 text-center mt-4 mt-lg-0">
                <div class="bg-white bg-opacity-10 p-4 rounded-4 backdrop-blur border border-white border-opacity-10">
                    <i class="fas fa-user-shield fa-3x text-warning mb-3"></i>
                    <h5 class="fw-bold mb-1">Staff Access Only</h5>
                    <p class="small text-light opacity-75 mb-3">Authorized Kitchen & Cashier Terminals</p>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-warning text-dark fw-bold rounded-pill px-4 shadow">
                        <i class="fas fa-sign-in-alt me-1"></i> Staff Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Staff Portals Grid -->
<div class="row g-4 mb-4">
    <!-- Kitchen Staff Portal Card -->
    <div class="col-md-6">
        <div class="card card-custom h-100 bg-white border-0 shadow-sm rounded-4">
            <div class="card-body p-4 text-center">
                <div class="rounded-circle bg-warning bg-opacity-10 p-4 d-inline-block mb-3 text-warning">
                    <i class="fas fa-fire fa-4x"></i>
                </div>
                <h3 class="fw-bold text-dark mb-2">Kitchen Staff KDS Terminal</h3>
                <p class="text-muted mb-4">Smart workload-balanced KDS terminal for kitchen chefs. Review assigned orders, urgency timers, and advance order preparation status.</p>

                <a asp-controller="Kitchen" asp-action="Index" class="btn btn-warning text-dark btn-lg w-100 fw-bold rounded-pill shadow">
                    Open Kitchen KDS Terminal <i class="fas fa-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Cashier Staff Portal Card -->
    <div class="col-md-6">
        <div class="card card-custom h-100 bg-white border-0 shadow-sm rounded-4">
            <div class="card-body p-4 text-center">
                <div class="rounded-circle bg-success bg-opacity-10 p-4 d-inline-block mb-3 text-success">
                    <i class="fas fa-cash-register fa-4x"></i>
                </div>
                <h3 class="fw-bold text-dark mb-2">Cashier Billing Terminal</h3>
                <p class="text-muted mb-4">Review active tables and bill requests, generate itemized invoices, process cash/card payments, and print thermal receipts.</p>

                <a asp-controller="Cashier" asp-action="Index" class="btn btn-success btn-lg w-100 fw-bold rounded-pill shadow">
                    Open Cashier Billing Terminal <i class="fas fa-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Active Staff Team Section -->
<div class="card card-custom bg-white border-0 shadow-sm rounded-4 p-4 mb-4">
    <h5 class="fw-bold text-dark mb-3"><i class="fas fa-users text-primary me-2"></i> Active Hotel Staff Team Details</h5>
    <div class="row g-3">
        <div class="col-md-6">
            <div class="p-3 bg-light rounded-3 border">
                <h6 class="fw-bold text-warning mb-2"><i class="fas fa-user-chef me-2"></i> Kitchen Chefs Team</h6>
                <ul class="mb-0 small text-muted">
                    <li>Chef Sanath Perera (Head Chef) - <code>kitchen1@hotel.com</code></li>
                    <li>Chef Kamal Silva - <code>kitchen2@hotel.com</code></li>
                    <li>Chef Nimal Fernando - <code>kitchen3@hotel.com</code></li>
                </ul>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 bg-light rounded-3 border">
                <h6 class="fw-bold text-success mb-2"><i class="fas fa-receipt me-2"></i> Cashier Billing Team</h6>
                <ul class="mb-0 small text-muted">
                    <li>Cashier Ruwan Mendis - <code>cashier1@hotel.com</code></li>
                    <li>Cashier Dilani Jayawardena - <code>cashier2@hotel.com</code></li>
                </ul>
            </div>
        </div>
    </div>
</div>
