@model HotelBillingSystem.ViewModels.KitchenDashboardViewModel
@{
    ViewData["Title"] = "Kitchen KDS Display";
    Layout = "_Layout";
    var unassignedOrders = (List<HotelBillingSystem.Models.Order>)ViewBag.UnassignedOrders;
}

<div class="row mb-4 align-items-center bg-white p-3 rounded-4 shadow-sm" style="border: 1.5px solid #e2e8f0 !important;">
    <div class="col-md-6 d-flex align-items-center gap-3">
        <div class="story-ring-box" style="width: 48px; height: 48px;">
            <div class="story-ring-inner w-100 h-100">
                <i class="fas fa-fire text-danger fs-5"></i>
            </div>
        </div>
        <div>
            <h2 class="fw-bold mb-0 text-dark">Kitchen KDS <span class="ig-gradient-text">Terminal</span></h2>
            <p class="text-secondary small mb-0 fw-semibold">Assigned Chef: <strong class="text-dark">@Model.KitchenUser.FullName</strong></p>
        </div>
    </div>
    <div class="col-md-6 text-md-end mt-2 mt-md-0">
        <div class="d-inline-flex align-items-center bg-light p-2 rounded-pill border">
            <span class="fw-bold me-2 ms-2 small text-dark">My Work Status:</span>
            <select id="staffStatusSelect" class="form-select form-select-sm fw-bold border-0 bg-white rounded-pill px-3 shadow-sm" onchange="updateStaffStatus(this.value)">
                <option value="1" selected="@(Model.CurrentStaffStatus == HotelBillingSystem.Models.StaffStatus.Available)">🟢 AVAILABLE</option>
                <option value="2" selected="@(Model.CurrentStaffStatus == HotelBillingSystem.Models.StaffStatus.Busy)">🟡 BUSY</option>
                <option value="4" selected="@(Model.CurrentStaffStatus == HotelBillingSystem.Models.StaffStatus.OnBreak)">☕ ON BREAK</option>
                <option value="3" selected="@(Model.CurrentStaffStatus == HotelBillingSystem.Models.StaffStatus.Offline)">🔴 OFFLINE</option>
            </select>
        </div>
    </div>
</div>

<!-- SECTION 1: UNASSIGNED ORDERS POOL (FIRST-COME, FIRST-SERVED CLAIMING) -->
<div class="card rounded-4 p-4 mb-4 shadow-sm" style="background: linear-gradient(135deg, #ffffff 0%, #fffbf5 100%); border: 1.5px solid #fed7aa !important;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0 text-dark">
            <i class="fas fa-bell text-danger me-2"></i> Incoming Orders - First Come Claiming Pool
        </h4>
        <span class="badge badge-ig-gradient fs-6 rounded-pill px-3 py-2 fw-bold">@unassignedOrders.Count Unclaimed Orders</span>
    </div>
    <p class="text-secondary small mb-3 fw-semibold">All customer orders arrive here. Whichever chef clicks <strong>"Claim & Start Making"</strong> first gets assigned to make the order.</p>

    <div class="row g-3">
        @if (!unassignedOrders.Any())
        {
            <div class="col-12 text-center py-3">
                <span class="text-secondary fw-bold"><i class="fas fa-check-circle me-1 text-success"></i> No unclaimed orders. All customer orders are currently being prepared.</span>
            </div>
        }

        @foreach (var order in unassignedOrders)
        {
            <div class="col-md-6 col-lg-4" id="unassigned-card-@order.Id">
                <div class="card h-100 bg-white shadow-sm rounded-4 overflow-hidden" style="border: 1.5px solid #fed7aa !important;">
                    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-2">
                        <span class="fw-bold text-dark"><i class="fas fa-chair text-primary me-1"></i> @order.Table?.TableNumber</span>
                        <span class="badge badge-ig-gradient">NEW ORDER</span>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <code class="fw-bold fs-6">#@order.OrderNumber</code>
                            <small class="text-muted"><i class="far fa-clock me-1"></i> @order.CreatedAt.ToString("HH:mm:ss")</small>
                        </div>
                        @if (!string.IsNullOrEmpty(order.CustomerNotes))
                        {
                            <div class="alert alert-warning py-1 px-2 small mb-2 fw-bold">
                                <i class="fas fa-exclamation-triangle me-1"></i> Note: @order.CustomerNotes
                            </div>
                        }
                        <ul class="list-group list-group-flush mb-3">
                            @foreach (var item in order.OrderItems)
                            {
                                <li class="list-group-item px-0 py-1 d-flex justify-content-between border-0 small">
                                    <span>@item.FoodName</span>
                                    <span class="badge bg-primary rounded-pill">x @item.Quantity</span>
                                </li>
                            }
                        </ul>
                    </div>
                    <div class="card-footer bg-white p-3 border-top">
                        <button class="btn btn-instagram w-100 fw-bold rounded-pill shadow-sm" onclick="claimOrder(@order.Id)">
                            <i class="fas fa-hand-pointer me-2"></i> Claim & Start Making
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- SECTION 2: MY CLAIMED ACTIVE ORDERS QUEUE -->
<div class="row g-4 mb-5" id="kitchenOrdersGrid">
    <div class="col-12">
        <h4 class="fw-bold mb-0 text-dark"><i class="fas fa-fire me-2 text-danger"></i> My Active Making Queue (@Model.AssignedActiveOrders.Count Orders)</h4>
    </div>

    @if (!Model.AssignedActiveOrders.Any())
    {
        <div class="col-12 text-center py-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white" style="border: 1.5px solid #e2e8f0 !important;">
                <i class="fas fa-utensils fa-3x text-secondary mb-2 opacity-50"></i>
                <h5 class="fw-bold text-dark">No Orders Currently Claimed by You</h5>
                <p class="text-secondary mb-0">Claim orders from the Incoming Orders Pool above to start making them.</p>
            </div>
        </div>
    }

    @foreach (var order in Model.AssignedActiveOrders)
    {
        double elapsedMinutes = (DateTime.UtcNow - order.CreatedAt).TotalMinutes;
        string cardUrgencyClass = elapsedMinutes > 20 ? "kds-card-urgent" : (elapsedMinutes > 10 ? "kds-card-warning" : "kds-card-normal");
        string urgencyBadgeClass = elapsedMinutes > 20 ? "bg-danger" : (elapsedMinutes > 10 ? "bg-warning text-dark" : "bg-success");
        string urgencyLabel = elapsedMinutes > 20 ? "URGENT (20m+)" : (elapsedMinutes > 10 ? "WARNING (10m+)" : "NORMAL");

        <div class="col-md-6 col-lg-4" id="order-card-@order.Id">
            <div class="card card-custom h-100 bg-white overflow-hidden @cardUrgencyClass">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                    <div>
                        <h5 class="fw-bold mb-0 text-warning"><i class="fas fa-chair me-1"></i> @order.Table?.TableNumber</h5>
                        <small class="text-white-50">Order #@order.OrderNumber</small>
                    </div>
                    <div class="text-end">
                        <span class="badge @urgencyBadgeClass px-2 py-1 fw-bold">@urgencyLabel</span>
                        <div class="small text-white-50 mt-1"><i class="far fa-clock me-1"></i> @order.CreatedAt.ToString("HH:mm:ss")</div>
                    </div>
                </div>

                <div class="card-body p-3">
                    @if (!string.IsNullOrEmpty(order.CustomerNotes))
                    {
                        <div class="alert alert-warning py-2 px-3 small mb-3 fw-bold rounded-3 border-0">
                            <i class="fas fa-exclamation-triangle me-1"></i> Customer Note: @order.CustomerNotes
                        </div>
                    }

                    <h6 class="fw-bold border-bottom pb-2 text-primary"><i class="fas fa-list-check me-1"></i> Items to Prepare:</h6>
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var item in order.OrderItems)
                        {
                            <li class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center border-bottom">
                                <div>
                                    <span class="fw-bold fs-6 text-dark">@item.FoodName</span>
                                    @if (!string.IsNullOrEmpty(item.SpecialInstructions))
                                    {
                                        <div class="small text-danger fw-semibold"><i class="fas fa-asterisk me-1"></i> @item.SpecialInstructions</div>
                                    }
                                </div>
                                <span class="badge bg-primary rounded-pill fs-6 px-3">x @item.Quantity</span>
                            </li>
                        }
                    </ul>
                </div>

                <div class="card-footer bg-light p-3 border-top">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fw-bold small text-muted">Current Status:</span>
                        <span class="badge bg-secondary px-3 py-1 fs-6" id="status-badge-@order.Id">@order.Status</span>
                    </div>

                    <div id="action-buttons-@order.Id" class="d-grid gap-2">
                        @if (order.Status == HotelBillingSystem.Models.OrderStatus.Accepted)
                        {
                            <button class="btn btn-warning text-dark btn-lg fw-bold rounded-pill shadow-sm" onclick="updateOrderStatus(@order.Id, 4)">
                                <i class="fas fa-fire me-1"></i> Start Preparing / Making
                            </button>
                        }
                        else if (order.Status == HotelBillingSystem.Models.OrderStatus.Preparing)
                        {
                            <button class="btn btn-success btn-lg fw-bold rounded-pill shadow-sm" onclick="updateOrderStatus(@order.Id, 5)">
                                <i class="fas fa-check-circle me-1"></i> Mark as Finished / Ready
                            </button>
                        }
                        else if (order.Status == HotelBillingSystem.Models.OrderStatus.Ready)
                        {
                            <button class="btn btn-info text-white btn-lg fw-bold rounded-pill shadow-sm" onclick="updateOrderStatus(@order.Id, 6)">
                                <i class="fas fa-concierge-bell me-1"></i> Mark as Served
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    async function claimOrder(orderId) {
        try {
            let res = await fetch(`/Kitchen/ClaimOrder?orderId=${orderId}`, { method: 'POST' });
            let data = await res.json();
            if (data.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Order Claimed!',
                    text: `Order #${orderId} claimed by ${data.chefName}. Added to your queue.`,
                    timer: 1500,
                    showConfirmButton: false
                }).then(() => {
                    window.location.reload();
                });
            } else {
                Swal.fire({ icon: 'warning', title: 'Already Claimed', text: data.message });
                window.location.reload();
            }
        } catch (e) {
            Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to claim order.' });
        }
    }

    async function updateOrderStatus(orderId, newStatus) {
        try {
            let res = await fetch(`/Kitchen/UpdateStatus?orderId=${orderId}&newStatus=${newStatus}`, { method: 'POST' });
            let data = await res.json();
            if (data.success) {
                window.location.reload();
            } else {
                Swal.fire({ icon: 'error', title: 'Error', text: data.message });
            }
        } catch (e) {
            Swal.fire({ icon: 'error', title: 'Error', text: 'Server connection error.' });
        }
    }

    async function updateStaffStatus(statusValue) {
        try {
            let res = await fetch(`/Kitchen/UpdateStaffStatus?status=${statusValue}`, { method: 'POST' });
            let data = await res.json();
            if (data.success) {
                Swal.fire({ icon: 'success', title: 'Status Updated', timer: 1200, showConfirmButton: false });
            }
        } catch (e) {
            console.error(e);
        }
    }

    // SignalR Real-Time Listener
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/hotelHub")
        .build();

    connection.on("ReceiveNewKitchenOrder", function(order) {
        playNotificationChime();
        window.location.reload();
    });

    connection.on("OrderClaimedByChef", function(orderId, chefName) {
        window.location.reload();
    });

    connection.start().then(() => {
        connection.invoke("JoinGroup", "Kitchen");
    }).catch(err => console.error(err));
</script>
}
