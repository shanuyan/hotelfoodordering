@model HotelBillingSystem.ViewModels.OrderTrackingViewModel
@{
    ViewData["Title"] = $"Track Order #{Model.Order.OrderNumber}";
    Layout = "_Layout";
}

<div class="container my-3" style="max-width: 800px;">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-primary text-white p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="badge bg-warning text-dark px-3 py-2 fw-bold me-2 fs-6">Order #@Model.Order.OrderNumber</span>
                    <span class="badge bg-light text-primary px-3 py-2 fw-bold fs-6">@Model.Order.Table?.TableNumber</span>
                </div>
                <div>
                    <span id="currentStatusBadge" class="badge bg-success fs-6 px-3 py-2 pulse-badge">@Model.Order.Status</span>
                </div>
            </div>
            <p class="mb-0 mt-2 opacity-75 small"><i class="far fa-clock me-1"></i> Order Placed: @Model.Order.CreatedAt.ToString("f")</p>
        </div>

        <div class="card-body p-4">
            <h5 class="fw-bold mb-4 text-dark"><i class="fas fa-tasks me-2 text-primary"></i> Live Order Preparation Progress</h5>

            <!-- Step-by-Step Progress Timeline -->
            @{
                int statusInt = (int)Model.Order.Status;
            }
            <div class="row g-2 text-center mb-4 py-2 bg-light rounded-4 border">
                <div class="col-2 timeline-step @(statusInt >= 1 ? "completed" : "pending")">
                    <div class="icon-box"><i class="fas fa-receipt"></i></div>
                    <div class="small fw-bold">Received</div>
                </div>
                <div class="col-2 timeline-step @(statusInt >= 2 ? "completed" : "pending")">
                    <div class="icon-box"><i class="fas fa-user-check"></i></div>
                    <div class="small fw-bold">Assigned</div>
                </div>
                <div class="col-2 timeline-step @(statusInt >= 3 ? "completed" : "pending")">
                    <div class="icon-box"><i class="fas fa-thumbs-up"></i></div>
                    <div class="small fw-bold">Accepted</div>
                </div>
                <div class="col-2 timeline-step @(statusInt >= 4 ? (statusInt == 4 ? "active" : "completed") : "pending")">
                    <div class="icon-box"><i class="fas fa-fire"></i></div>
                    <div class="small fw-bold">Preparing</div>
                </div>
                <div class="col-2 timeline-step @(statusInt >= 5 ? (statusInt == 5 ? "active" : "completed") : "pending")">
                    <div class="icon-box"><i class="fas fa-bell"></i></div>
                    <div class="small fw-bold">Ready</div>
                </div>
                <div class="col-2 timeline-step @(statusInt >= 6 ? "completed" : "pending")">
                    <div class="icon-box"><i class="fas fa-concierge-bell"></i></div>
                    <div class="small fw-bold">Served</div>
                </div>
            </div>

            <!-- Assigned Kitchen Staff -->
            <div class="alert alert-info d-flex align-items-center rounded-3 my-4 shadow-sm border-0 border-start border-4 border-info">
                <i class="fas fa-user-tie fa-2x me-3 text-info"></i>
                <div>
                    <div class="fw-bold text-dark">Kitchen Chef Assigned:</div>
                    <div class="text-primary fw-semibold fs-6">@(Model.Order.AssignedKitchenStaff?.FullName ?? "Chef Sanath (Smart Workload Balanced)")</div>
                </div>
            </div>

            <!-- Ordered Dishes List -->
            <h5 class="fw-bold mb-3 text-dark"><i class="fas fa-utensils me-2 text-primary"></i> Ordered Items</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Food Item</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Order.OrderItems)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@item.FoodName</div>
                                    @if (!string.IsNullOrEmpty(item.SpecialInstructions))
                                    {
                                        <small class="text-danger fw-semibold"><i class="fas fa-info-circle me-1"></i> @item.SpecialInstructions</small>
                                    }
                                </td>
                                <td class="text-center fw-bold fs-6">@item.Quantity</td>
                                <td class="text-end">Rs. @item.UnitPrice.ToString("N2")</td>
                                <td class="text-end fw-bold text-primary">Rs. @item.SubTotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end fw-semibold">Food Subtotal:</td>
                            <td class="text-end fw-semibold">Rs. @Model.Order.SubTotal.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end fw-semibold">Service Charge (10%):</td>
                            <td class="text-end fw-semibold">Rs. @Model.Order.ServiceCharge.ToString("N2")</td>
                        </tr>
                        <tr class="table-active">
                            <td colspan="3" class="text-end fw-bold fs-5">Grand Total:</td>
                            <td class="text-end fw-bold fs-4 text-primary">Rs. @Model.Order.TotalAmount.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-between align-items-center mt-4">
                <a asp-action="Menu" asp-route-tableId="@Model.Order.TableId" class="btn btn-outline-primary fw-bold rounded-pill px-4">
                    <i class="fas fa-plus me-1"></i> Add More Food Items
                </a>

                <button id="requestBillBtn" class="btn btn-warning btn-lg text-dark fw-bold rounded-pill px-4 shadow" onclick="requestBill()">
                    <i class="fas fa-receipt me-2"></i> Request Bill
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const orderId = @Model.Order.Id;
    const tableId = @Model.Order.TableId;

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/hotelHub")
        .build();

    connection.on("OrderStatusChanged", function(oId, newStatus, remarks) {
        if (oId === orderId) {
            playNotificationChime();
            document.getElementById('currentStatusBadge').innerText = newStatus;

            Swal.fire({
                icon: 'info',
                title: 'Order Status Update',
                text: `Order status changed to: ${newStatus}`,
                timer: 2000,
                showConfirmButton: false
            }).then(() => {
                window.location.reload();
            });
        }
    });

    connection.start().then(() => {
        connection.invoke("JoinGroup", `Order_${orderId}`);
        connection.invoke("JoinGroup", `Table_${tableId}`);
    }).catch(err => console.error(err));

    async function requestBill() {
        let btn = document.getElementById('requestBillBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Requesting...';

        try {
            let res = await fetch(`/Order/RequestBill?tableId=${tableId}`, { method: 'POST' });
            let data = await res.json();
            if (data.success) {
                btn.className = "btn btn-success btn-lg text-white fw-bold rounded-pill px-4";
                btn.innerHTML = '<i class="fas fa-check-circle me-2"></i> Bill Requested!';
                Swal.fire({
                    icon: 'success',
                    title: 'Bill Requested!',
                    text: 'Cashier notified. A staff member will attend to your table shortly.',
                    confirmButtonColor: '#10b981'
                });
            } else {
                Swal.fire({ icon: 'error', title: 'Request Failed', text: data.message });
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-receipt me-2"></i> Request Bill';
            }
        } catch (e) {
            Swal.fire({ icon: 'error', title: 'Error', text: 'Server connection error.' });
            btn.disabled = false;
        }
    }
</script>
}
