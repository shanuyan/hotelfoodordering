@model HotelBillingSystem.ViewModels.CustomerMenuViewModel
@{
    ViewData["Title"] = $"Menu - {Model.Table.TableNumber}";
    Layout = "_Layout";
}

<div class="container my-2" style="max-width: 900px;">
    <!-- Welcome Table Banner -->
    <div class="card bg-dark text-white border-0 shadow-sm mb-3 rounded-4 overflow-hidden">
        <div class="card-body p-4 d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-success text-white px-3 py-2 mb-2 fs-6">
                    <i class="fas fa-circle me-1"></i> Connected
                </span>
                <h2 class="fw-bold mb-1"><i class="fas fa-chair me-2 text-warning"></i> @Model.Table.TableNumber</h2>
                <p class="mb-0 opacity-75 fs-6"><i class="fas fa-location-dot me-1"></i> @Model.Table.Location | Session: <code>@Model.Session.SessionCode</code></p>
            </div>
            <div>
                @if (Model.SessionOrders.Any())
                {
                    <a asp-action="Track" asp-route-id="@Model.SessionOrders.First().Id" class="btn btn-warning text-dark fw-bold rounded-pill px-3 py-2 shadow-sm">
                        <i class="fas fa-clock me-1"></i> Track Active Order
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Search Bar -->
    <div class="mb-3">
        <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden border">
            <span class="input-group-text bg-white border-0 ps-3 text-muted"><i class="fas fa-search"></i></span>
            <input type="text" id="foodSearchInput" class="form-control border-0 ps-2" placeholder="Search delicious dishes or beverages...">
        </div>
    </div>

    <!-- Category Nav Pills -->
    <ul class="nav nav-pills flex-nowrap overflow-auto mb-4 pb-2 border-bottom" id="categoryTabs" role="tablist">
        <li class="nav-item me-2">
            <button class="nav-link active rounded-pill fw-bold px-4 py-2" id="cat-all-tab" data-bs-toggle="pill" data-bs-target="#cat-all" type="button">
                All Items
            </button>
        </li>
        @foreach (var cat in Model.Categories)
        {
            <li class="nav-item me-2">
                <button class="nav-link rounded-pill fw-bold px-4 py-2" id="cat-@cat.Id-tab" data-bs-toggle="pill" data-bs-target="#cat-@cat.Id" type="button">
                    @cat.Name
                </button>
            </li>
        }
    </ul>

    <!-- Menu Items List -->
    <div class="tab-content" id="categoryTabContent">
        <!-- ALL Items Tab -->
        <div class="tab-pane fade show active" id="cat-all" role="tabpanel">
            <div class="row g-3" id="allFoodContainer">
                @foreach (var cat in Model.Categories)
                {
                    @foreach (var item in cat.FoodItems)
                    {
                        <div class="col-md-6 food-card-wrapper" data-name="@item.Name.ToLower()" data-category="@cat.Id">
                            <div class="card h-100 border-0 shadow-sm rounded-3 food-card overflow-hidden">
                                <div class="row g-0 h-100 align-items-center">
                                    <div class="col-4 p-2 text-center bg-light">
                                        <div class="ratio ratio-1x1 rounded-3 overflow-hidden bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center">
                                            <i class="fas fa-utensils fa-2x text-secondary opacity-50"></i>
                                        </div>
                                    </div>
                                    <div class="col-8">
                                        <div class="card-body p-3">
                                            <div class="d-flex justify-content-between align-items-start mb-1">
                                                <h5 class="card-title fw-bold text-dark mb-0 fs-6">@item.Name</h5>
                                                <span class="badge bg-primary rounded-pill">Rs. @item.Price.ToString("N2")</span>
                                            </div>
                                            <p class="card-text text-muted small mb-2 text-truncate-2">@item.Description</p>

                                            <div class="d-flex justify-content-between align-items-center">
                                                <small class="text-muted"><i class="far fa-clock me-1"></i> ~@item.PrepTimeMinutes min</small>

                                                <div id="item-action-@item.Id">
                                                    @if (item.IsAvailable)
                                                    {
                                                        <button class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold add-to-cart-btn"
                                                                data-id="@item.Id" data-name="@item.Name" data-price="@item.Price">
                                                            <i class="fas fa-plus me-1"></i> Add
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger text-uppercase px-2 py-1">Unavailable</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Per Category Tabs -->
        @foreach (var cat in Model.Categories)
        {
            <div class="tab-pane fade" id="cat-@cat.Id" role="tabpanel">
                <div class="row g-3">
                    @foreach (var item in cat.FoodItems)
                    {
                        <div class="col-md-6 food-card-wrapper" data-name="@item.Name.ToLower()">
                            <div class="card h-100 border-0 shadow-sm rounded-3 food-card overflow-hidden">
                                <div class="row g-0 h-100 align-items-center">
                                    <div class="col-4 p-2 text-center bg-light">
                                        <div class="ratio ratio-1x1 rounded-3 overflow-hidden bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center">
                                            <i class="fas fa-utensils fa-2x text-secondary opacity-50"></i>
                                        </div>
                                    </div>
                                    <div class="col-8">
                                        <div class="card-body p-3">
                                            <h5 class="card-title fw-bold text-dark mb-1 fs-6">@item.Name</h5>
                                            <p class="card-text text-muted small mb-2">@item.Description</p>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="fw-bold text-primary">Rs. @item.Price.ToString("N2")</span>
                                                @if (item.IsAvailable)
                                                {
                                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold add-to-cart-btn"
                                                            data-id="@item.Id" data-name="@item.Name" data-price="@item.Price">
                                                        <i class="fas fa-plus me-1"></i> Add
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger text-uppercase px-2 py-1">Unavailable</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Floating Mobile Cart Bar -->
<div id="floatingCartBar" class="fixed-bottom bg-dark text-white p-3 shadow-lg border-top d-none" style="z-index: 1050;">
    <div class="container d-flex justify-content-between align-items-center" style="max-width: 900px;">
        <div>
            <span class="badge bg-primary me-2 fs-6" id="cartBadgeCount">0 Items</span>
            <span class="fw-bold fs-5 text-warning" id="cartBarTotal">Rs. 0.00</span>
        </div>
        <button class="btn btn-warning btn-lg fw-bold rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#cartModal">
            View Cart <i class="fas fa-shopping-basket ms-2"></i>
        </button>
    </div>
</div>

<!-- Cart Modal -->
<div class="modal fade" id="cartModal" tabindex="-1" aria-labelledby="cartModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header bg-primary text-white rounded-top-4">
                <h5 class="modal-header-title fw-bold modal-title" id="cartModalLabel">
                    <i class="fas fa-shopping-cart me-2"></i> Your Order Cart - @Model.Table.TableNumber
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="cartItemsContainer">
                    <!-- Cart Items injected via JS -->
                </div>

                <div class="mt-4">
                    <label class="form-label fw-bold"><i class="fas fa-comment-dots me-1"></i> Special Requests / Table Notes</label>
                    <textarea id="customerNotes" class="form-control" rows="2" placeholder="e.g. Less spicy, bring extra water glasses..."></textarea>
                </div>

                <hr />

                <div class="d-flex justify-content-between align-items-center fs-5 fw-bold">
                    <span>Estimated Total (Incl. Service Charge):</span>
                    <span class="text-primary fs-4" id="modalGrandTotal">Rs. 0.00</span>
                </div>
            </div>
            <div class="modal-footer bg-light rounded-bottom-4">
                <button type="button" class="btn btn-outline-secondary fw-bold rounded-pill" data-bs-dismiss="modal">Continue Ordering</button>
                <button type="button" class="btn btn-success btn-lg fw-bold rounded-pill px-4 shadow-sm" id="placeOrderBtn">
                    <i class="fas fa-paper-plane me-2"></i> Place Order Now
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let cart = [];
    const tableId = @Model.Table.Id;

    // Search filter
    document.getElementById('foodSearchInput').addEventListener('keyup', function() {
        let query = this.value.toLowerCase();
        let wrappers = document.querySelectorAll('.food-card-wrapper');
        wrappers.forEach(w => {
            let name = w.getAttribute('data-name');
            w.style.display = name.includes(query) ? '' : 'none';
        });
    });

    // Add to cart event
    document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            let id = parseInt(this.getAttribute('data-id'));
            let name = this.getAttribute('data-name');
            let price = parseFloat(this.getAttribute('data-price'));

            let existing = cart.find(x => x.foodItemId === id);
            if (existing) {
                existing.quantity++;
            } else {
                cart.push({ foodItemId: id, name: name, price: price, quantity: 1, specialInstructions: '' });
            }

            updateCartUI();
        });
    });

    function updateCartUI() {
        let totalCount = cart.reduce((sum, item) => sum + item.quantity, 0);
        let subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
        let estTotal = subtotal * 1.10; // Service charge

        let cartBar = document.getElementById('floatingCartBar');
        if (totalCount > 0) {
            cartBar.classList.remove('d-none');
            document.getElementById('cartBadgeCount').innerText = `${totalCount} ${totalCount === 1 ? 'Item' : 'Items'}`;
            document.getElementById('cartBarTotal').innerText = `Rs. ${estTotal.toFixed(2)}`;
            document.getElementById('modalGrandTotal').innerText = `Rs. ${estTotal.toFixed(2)}`;
        } else {
            cartBar.classList.add('d-none');
        }

        // Render modal list
        let container = document.getElementById('cartItemsContainer');
        if (cart.length === 0) {
            container.innerHTML = '<p class="text-muted text-center my-4">Your cart is currently empty.</p>';
            return;
        }

        let html = '<div class="list-group list-group-flush">';
        cart.forEach((item, index) => {
            let itemTotal = item.price * item.quantity;
            html += `
                <div class="list-group-item px-0 py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-0">${item.name}</h6>
                            <small class="text-primary fw-bold">Rs. ${item.price.toFixed(2)} each</small>
                        </div>
                        <div class="d-flex align-items-center">
                            <button class="btn btn-sm btn-outline-secondary rounded-circle px-2 py-0 me-2" onclick="changeQty(${index}, -1)">-</button>
                            <span class="fw-bold px-2">${item.quantity}</span>
                            <button class="btn btn-sm btn-outline-secondary rounded-circle px-2 py-0 ms-2" onclick="changeQty(${index}, 1)">+</button>
                            <span class="fw-bold text-dark ms-3 min-width-80 text-end">Rs. ${itemTotal.toFixed(2)}</span>
                        </div>
                    </div>
                    <input type="text" class="form-control form-control-sm mt-2" placeholder="Item special instructions (e.g. less sauce)"
                           value="${item.specialInstructions}" onchange="updateNote(${index}, this.value)" />
                </div>
            `;
        });
        html += '</div>';
        container.innerHTML = html;
    }

    function changeQty(index, delta) {
        cart[index].quantity += delta;
        if (cart[index].quantity <= 0) {
            cart.splice(index, 1);
        }
        updateCartUI();
    }

    function updateNote(index, text) {
        cart[index].specialInstructions = text;
    }

    // Submit Order
    document.getElementById('placeOrderBtn').addEventListener('click', async function() {
        if (cart.length === 0) return;

        this.disabled = true;
        this.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Submitting Order...';

        let notes = document.getElementById('customerNotes').value;
        let payload = {
            tableId: tableId,
            items: cart.map(x => ({ foodItemId: x.foodItemId, quantity: x.quantity, specialInstructions: x.specialInstructions })),
            customerNotes: notes
        };

        try {
            let response = await fetch('/Order/PlaceOrder', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            let res = await response.json();
            if (res.success) {
                cart = [];
                window.location.href = res.redirectUrl;
            } else {
                alert('Error placing order: ' + res.message);
                this.disabled = false;
                this.innerHTML = '<i class="fas fa-paper-plane me-2"></i> Place Order Now';
            }
        } catch (err) {
            alert('Server error. Please try again.');
            this.disabled = false;
            this.innerHTML = '<i class="fas fa-paper-plane me-2"></i> Place Order Now';
        }
    });

    // SignalR Real-Time Availability Listener
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/hotelHub")
        .build();

    connection.on("FoodAvailabilityUpdated", function(foodId, foodName, isAvailable) {
        let actionDiv = document.getElementById(`item-action-${foodId}`);
        if (actionDiv) {
            if (isAvailable) {
                actionDiv.innerHTML = `<button class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold add-to-cart-btn" data-id="${foodId}" data-name="${foodName}">+ Add</button>`;
            } else {
                actionDiv.innerHTML = `<span class="badge bg-danger text-uppercase px-2 py-1">Unavailable</span>`;
                // Remove from cart if present
                cart = cart.filter(x => x.foodItemId !== foodId);
                updateCartUI();
            }
        }
    });

    connection.start().catch(err => console.error(err.toString()));
</script>
}
