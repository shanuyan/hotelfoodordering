@model HotelBillingSystem.ViewModels.CashierDashboardViewModel
@{
    ViewData["Title"] = "Cashier Billing Terminal";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded-4 shadow-sm border">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="fas fa-cash-register me-2 text-success"></i> Cashier Billing Terminal</h2>
        <p class="text-muted mb-0">Active table dining sessions and bill requests</p>
    </div>
</div>

<!-- Active Table Sessions Grid -->
<div class="row g-4 mb-5">
    <div class="col-12">
        <h4 class="fw-bold mb-3 text-primary"><i class="fas fa-chair me-2"></i> Active Tables & Bill Requests</h4>
    </div>

    @if (!Model.ActiveSessions.Any())
    {
        <div class="col-12 text-center py-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                <i class="fas fa-info-circle fa-2x text-muted mb-2"></i>
                <h5 class="fw-bold text-muted">No Active Occupied Tables</h5>
                <p class="text-muted mb-0">When customers scan QR codes and place orders, active dining sessions will appear here.</p>
            </div>
        </div>
    }

    @foreach (var session in Model.ActiveSessions)
    {
        string cardBorder = session.IsBillRequested ? "border-danger border-3 shadow-lg" : "border-success border-2 shadow-sm";

        <div class="col-md-6 col-lg-4">
            <div class="card card-custom h-100 bg-white overflow-hidden @cardBorder">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                    <div>
                        <h5 class="fw-bold mb-0 text-warning"><i class="fas fa-chair me-1"></i> @session.Table?.TableNumber</h5>
                        <small class="text-white-50">Session: <code>@session.SessionCode</code></small>
                    </div>
                    @if (session.IsBillRequested)
                    {
                        <span class="badge bg-danger fs-6 px-3 py-2 pulse-badge">
                            <i class="fas fa-bell me-1"></i> BILL REQUESTED
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success px-2 py-1">Active Dining</span>
                    }
                </div>

                <div class="card-body p-3">
                    <p class="mb-2 text-muted small"><i class="far fa-clock me-1 text-warning"></i> Started: @session.StartTime.ToString("HH:mm")</p>
                    <h6 class="fw-bold text-dark border-bottom pb-2">Orders in Session (@session.Orders.Count):</h6>

                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var order in session.Orders)
                        {
                            <li class="list-group-item px-0 py-1 d-flex justify-content-between align-items-center border-0 small">
                                <span class="fw-bold">#@order.OrderNumber (@order.OrderItems.Count items)</span>
                                <span class="badge bg-info text-white">@order.Status</span>
                            </li>
                        }
                    </ul>

                    <div class="d-flex justify-content-between align-items-center bg-light p-3 rounded-3">
                        <span class="fw-bold text-muted">Current Subtotal:</span>
                        <span class="fw-bold fs-5 text-primary">Rs. @session.TotalAmount.ToString("N2")</span>
                    </div>
                </div>

                <div class="card-footer bg-light p-3 border-top">
                    <a asp-action="GenerateBill" asp-route-sessionId="@session.Id" class="btn btn-success btn-lg w-100 fw-bold rounded-pill shadow">
                        <i class="fas fa-file-invoice-dollar me-2"></i> Review & Generate Bill
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<!-- Recent Processed Invoices Table -->
<div class="card card-custom bg-white border-0 shadow-sm rounded-4">
    <div class="card-header bg-white py-3 border-bottom">
        <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-history me-2 text-secondary"></i> Recent Processed Invoices</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Invoice #</th>
                        <th>Table</th>
                        <th>Grand Total</th>
                        <th>Payment Method</th>
                        <th>Status</th>
                        <th>Processed At</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bill in Model.RecentBills)
                    {
                        <tr>
                            <td class="fw-bold"><code>@bill.InvoiceNumber</code></td>
                            <td><span class="badge bg-secondary">@bill.Table?.TableNumber</span></td>
                            <td class="fw-bold text-success">Rs. @bill.GrandTotal.ToString("N2")</td>
                            <td><span class="badge bg-primary">@bill.PaymentMethod</span></td>
                            <td><span class="badge bg-success">@bill.PaymentStatus</span></td>
                            <td>@bill.CreatedAt.ToString("g")</td>
                            <td class="text-end">
                                <a asp-action="Receipt" asp-route-id="@bill.Id" class="btn btn-sm btn-outline-primary fw-bold rounded-pill px-3">
                                    <i class="fas fa-print me-1"></i> Print Receipt
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/hotelHub")
        .build();

    connection.on("BillRequestedNotification", function(tableId, tableNumber, sessionId) {
        playNotificationChime();
        Swal.fire({
            icon: 'warning',
            title: 'Bill Requested!',
            text: `${tableNumber} has requested the bill.`,
            confirmButtonText: 'View Session',
            confirmButtonColor: '#10b981'
        }).then(() => {
            window.location.reload();
        });
    });

    connection.start().then(() => {
        connection.invoke("JoinGroup", "Cashier");
    }).catch(err => console.error(err));
</script>
}
