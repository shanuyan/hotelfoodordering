@model HotelBillingSystem.ViewModels.BillInvoiceViewModel
@{
    ViewData["Title"] = $"Receipt #{Model.Bill.InvoiceNumber}";
    Layout = "_Layout";
}

<div class="container my-4 d-flex justify-content-center">
    <div class="card shadow border-0 p-4 bg-white" style="max-width: 450px; width: 100%; font-family: 'Courier New', Courier, monospace;">
        <div class="text-center mb-3">
            <h3 class="fw-bold mb-1">PANNAUM SMART HOTEL</h3>
            <p class="mb-0 small">No 123, Beach Road, Colombo</p>
            <p class="mb-0 small">Tel: +94 11 234 5678</p>
            <hr class="my-2 border-dashed" />
            <h5 class="fw-bold text-uppercase mb-0">RECEIPT / INVOICE</h5>
            <small>Inv #: <strong>@Model.Bill.InvoiceNumber</strong></small>
        </div>

        <div class="d-flex justify-content-between small mb-2">
            <span>Date: @Model.Bill.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
            <span>Table: <strong>@Model.Table.TableNumber</strong></span>
        </div>
        <div class="small mb-3">
            <span>Cashier: @(Model.Bill.CashierUser?.FullName ?? "Cashier Staff")</span>
        </div>

        <hr class="my-2" />

        <table class="w-100 small mb-3">
            <thead>
                <tr class="border-bottom">
                    <th class="text-start">ITEM</th>
                    <th class="text-center">QTY</th>
                    <th class="text-end">PRICE</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Orders)
                {
                    @foreach (var item in order.OrderItems)
                    {
                        <tr>
                            <td>@item.FoodName</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end">@item.SubTotal.ToString("N2")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <hr class="my-2" />

        <div class="d-flex justify-content-between small fw-bold mb-1">
            <span>SUBTOTAL:</span>
            <span>Rs. @Model.Bill.SubTotal.ToString("N2")</span>
        </div>
        <div class="d-flex justify-content-between small mb-1">
            <span>SERVICE CHARGE (10%):</span>
            <span>Rs. @Model.Bill.ServiceCharge.ToString("N2")</span>
        </div>
        @if (Model.Bill.DiscountAmount > 0)
        {
            <div class="d-flex justify-content-between small text-danger mb-1">
                <span>DISCOUNT (@Model.Bill.DiscountReason):</span>
                <span>- Rs. @Model.Bill.DiscountAmount.ToString("N2")</span>
            </div>
        }
        <hr class="my-2" />
        <div class="d-flex justify-content-between fs-5 fw-bold mb-3">
            <span>GRAND TOTAL:</span>
            <span>Rs. @Model.Bill.GrandTotal.ToString("N2")</span>
        </div>

        <div class="d-flex justify-content-between small mb-3">
            <span>Payment Method: <strong>@Model.Bill.PaymentMethod</strong></span>
            <span>Status: <strong class="text-success">@Model.Bill.PaymentStatus</strong></span>
        </div>

        <div class="text-center mt-3 pt-2 border-top">
            <p class="mb-1 fw-bold">THANK YOU FOR DINING WITH US!</p>
            <p class="mb-0 small text-muted">Please Come Again</p>
        </div>

        <div class="d-print-none mt-4 text-center">
            <button onclick="window.print()" class="btn btn-primary fw-bold rounded-pill px-4 me-2">
                <i class="fas fa-print me-1"></i> Print Receipt
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary fw-bold rounded-pill px-4">Done</a>
        </div>
    </div>
</div>
