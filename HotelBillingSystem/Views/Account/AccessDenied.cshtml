@{
    ViewData["Title"] = "Access Denied";
}

<div class="container text-center py-5">
    <div class="card border-0 shadow-lg p-5 rounded-4 d-inline-block" style="max-width: 500px;">
        <i class="fas fa-lock fa-4x text-danger mb-3"></i>
        <h2 class="fw-bold text-dark">Access Denied</h2>
        <p class="text-muted">You do not have permission to access this portal or resource. Please log in with an authorized staff account.</p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary fw-bold rounded-pill px-4 me-2">Staff Login</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary fw-bold rounded-pill px-4">Home Portal</a>
    </div>
</div>
