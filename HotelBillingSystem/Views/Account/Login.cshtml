@model HotelBillingSystem.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Staff Login";
}

<div class="row justify-content-center py-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden" style="border: 1.5px solid #e2e8f0 !important; background: #ffffff;">
            <div class="card-body p-4 p-md-5 text-center">
                
                <!-- Instagram Story Ring Logo Icon -->
                <div class="story-ring-box mb-3" style="width: 76px; height: 76px;">
                    <div class="story-ring-inner w-100 h-100">
                        <i class="fas fa-utensils text-dark fa-2x"></i>
                    </div>
                </div>

                <h2 class="fw-bold mb-1 text-dark">
                    <span class="ig-gradient-text">Smart Hotel</span>
                </h2>
                <p class="text-secondary small mb-4 fw-semibold">Staff & Operations Terminal Access</p>

                <form asp-action="Login" method="post" class="text-start">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small fw-bold mb-3"></div>
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold text-dark small">
                            <i class="fas fa-envelope text-primary me-1"></i> Email Address
                        </label>
                        <input asp-for="Email" class="form-control form-control-lg text-dark" placeholder="admin@hotel.com" required autocomplete="username" />
                        <span asp-validation-for="Email" class="text-danger small fw-semibold"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold text-dark small">
                            <i class="fas fa-lock text-primary me-1"></i> Password
                        </label>
                        <input asp-for="Password" type="password" class="form-control form-control-lg text-dark" placeholder="••••••••" required autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small fw-semibold"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label fw-semibold text-dark small">Keep me logged in</label>
                    </div>

                    <button type="submit" class="btn btn-instagram w-100 btn-lg fw-bold rounded-pill shadow-sm mb-3">
                        <i class="fas fa-sign-in-alt me-2"></i> Log In to Terminal
                    </button>
                </form>

                <div class="p-3 bg-light rounded-3 border text-start mt-3">
                    <p class="small fw-bold text-dark mb-1"><i class="fas fa-key text-warning me-1"></i> Quick Demo Logins:</p>
                    <div class="small text-secondary mb-1">👑 Admin: <code>admin@hotel.com</code> / <code>Admin@123</code></div>
                    <div class="small text-secondary mb-1">🍳 Kitchen: <code>kitchen1@hotel.com</code> / <code>Kitchen@123</code></div>
                    <div class="small text-secondary">💵 Cashier: <code>cashier1@hotel.com</code> / <code>Cashier@123</code></div>
                </div>
            </div>
            
            <div class="card-footer bg-white border-top text-center py-3">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none fw-bold text-dark small">
                    <i class="fas fa-arrow-left me-1"></i> Back to Main Portal
                </a>
            </div>
        </div>
    </div>
</div>
